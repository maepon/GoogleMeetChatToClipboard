# このファイルを .env にコピーして各自の値を設定する（.env は git 管理外）
#
# make が include するため Makefile の構文で書く。
# 値をそのまま書いても、シェルの環境変数を参照する形にしてもよい。

# Slack通知先の Incoming Webhook URL。必須。
# 未設定のまま make spec / impl / review を叩くとエラーで止まる。
SLACK_WEBHOOK_URL =

# 強モデル / 高速モデルのID。既定は環境変数 CLAUDE_CODE_OPUS_MODEL / CLAUDE_CODE_SONNET_MODEL から取る。
# それを定義していないなら、ここに直接書く。?= ではなく = で書く（Makefile 側で定義済みなので ?= は効かない）。
# STRONG_MODEL = <強モデルのID>
# FAST_MODEL = <高速モデルのID>
