# Copy this file to .env and fill in your own values (.env is not tracked by git).
#
# make includes it, so write it in Makefile syntax.
# Values can be written literally or refer to shell environment variables.

# Notifications (optional; see "Notifications" in docs/setup.md). With nothing set, there are none.
# Slack: set the Incoming Webhook URL. Without NOTIFY_CMD, Slack is used whenever this is set.
SLACK_WEBHOOK_URL =
# Another service: a command that gets the body on stdin and AI_FLOW_NOTIFY_* environment variables.
# Paths are relative to the flow directory. Set it empty (NOTIFY_CMD =) to turn notifications off even with SLACK_WEBHOOK_URL set.
# NOTIFY_CMD = $(AI_FLOW_PROJECT_DIR)/notify.sh
# Names of the variables holding the command's secrets. They are passed to NOTIFY_CMD and kept out of the agents' environment
# (default SLACK_WEBHOOK_URL). A variable not listed here does not reach NOTIFY_CMD at all.
# NOTIFY_SECRET_VARS = MY_WEBHOOK_URL
# MY_WEBHOOK_URL =

# Strong / fast model IDs. By default they come from the environment variables CLAUDE_CODE_OPUS_MODEL / CLAUDE_CODE_SONNET_MODEL.
# If you do not define those, write the IDs here. Use = rather than ?= (the Makefile defines them first, so ?= has no effect).
# STRONG_MODEL = <strong model ID>
# FAST_MODEL = <fast model ID>
